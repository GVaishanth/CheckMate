{
  "name": "checkmate",
  "private": true,
  "version": "1.0.0",
  "description": "Browser chess with engine opponents, opening and checkmate lessons, tactical puzzles, Elo estimation, and peer-to-peer multiplayer. Static, no backend.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit -p tsconfig.app.json && vite build && node scripts/postbuild.mjs",
    "preview": "vite preview --host 0.0.0.0 --port 4173",
    "typecheck": "tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.tools.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "bench": "tsx scripts/bench.ts",
    "gen:puzzles": "tsx scripts/generate-puzzles.ts",
    "gen:elo": "tsx scripts/generate-elo.ts",
    "postinstall": "node scripts/check-fonts.mjs"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.5"
  },
  "devDependencies": {
    "@types/node": "^20.16.11",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.7.0",
    "fake-indexeddb": "6.2.7",
    "tsx": "^4.19.1",
    "typescript": "^5.6.3",
    "vite": "^6.4.4",
    "vitest": "^4.1.12"
  },
  "license": "MIT",
  "engines": {
    "node": ">=22.12.0"
  }
}
